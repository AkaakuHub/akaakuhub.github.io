{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "akaakuhub",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-25",
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
  },
  "durable_objects": {
    "bindings": [{ "name": "WEATHER", "class_name": "TokyoWeatherCache" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TokyoWeatherCache"] }],
  "dev": { "ip": "127.0.0.1", "port": 8787 },
}
