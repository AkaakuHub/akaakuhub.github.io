{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "akaakuhub",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "akaaku.net", "custom_domain": true }],
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-25",
  "build": { "command": "pnpm build", "watch_dir": "worker" },
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
  },
  "durable_objects": {
    "bindings": [
      { "name": "WEATHER", "class_name": "TokyoWeatherCache" },
      { "name": "CONTENT", "class_name": "SiteContentCache" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["TokyoWeatherCache"] },
    { "tag": "v2", "new_sqlite_classes": ["SiteContentCache"] },
  ],
  "dev": { "ip": "127.0.0.1", "port": 8787 },
}
