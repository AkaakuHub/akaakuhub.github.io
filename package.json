{
  "name": "akaakuhub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "format": "oxfmt .",
    "lint": "oxlint --deny-warnings",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm knip",
    "fix": "oxfmt . && oxlint --fix",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker/tsconfig.json",
    "knip": "knip",
    "prepare": "lefthook install",
    "preinstall": "only-allow pnpm",
    "preview": "vp preview",
    "format:check": "oxfmt --check .",
    "dev:weather": "wrangler dev --local"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.2",
    "lucide": "^1.61.0",
    "marked": "^18.1.1",
    "suncalc": "^2.1.1",
    "three": "^0.186.1",
    "unified-asset-loader": "0.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261025.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "knip": "^6.42.1",
    "lefthook": "^2.2.2",
    "only-allow": "^1.2.2",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite-plus": "^1.4.0",
    "wrangler": "^4.152.0"
  }
}
